# Personal AI Gateway — .env.example
# 复制为 .env 后填入真实值。.env 永不提交 Git。
# 真实 OpenAI API Key 目前没有；等用户通过安全流程提供新密钥后再填。
# 严禁填入其他对话/截图里出现过的密钥（已泄露）。

# --- 上游 OpenAI（服务端注入，永不发给客户端） ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- 域名 / 服务 ---
GATEWAY_DOMAIN=ai.fafa888.uk
GATEWAY_PUBLIC_URL=https://ai.fafa888.uk
API_PORT=8000

# --- 数据库（生产 PostgreSQL；本地开发可用 SQLite） ---
DATABASE_URL=postgresql+psycopg://gateway:CHANGE_ME@db:5432/gateway
DATABASE_URL_DEV=sqlite:///./data/dev.db

# --- 管理员（首次启动时由初始化脚本创建，密码只设一次） ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- 会话 / 安全 ---
SESSION_SECRET=
SESSION_COOKIE_SECURE=true

# --- 本地预算（硬停，默认保守值，等用户定数字） ---
BUDGET_GLOBAL_DAILY_USD=5
BUDGET_GLOBAL_MONTHLY_USD=50
BUDGET_CLIENT_MONTHLY_USD=20

# --- 模型候选清单（仅配置，未验证 = 不可调用，见 docs/ARCHITECTURE.md §5） ---
CANDIDATE_MODELS=gpt-5.4-mini-2026-03-17,gpt-5.4-nano-2026-03-17,gpt-5.4-mini,gpt-5.4-nano,gpt-5.4,gpt-5.4-2026-03-05,gpt-5.6-sol,gpt-5.6-terra,gpt-6.1-sol,gpt-6-astra
